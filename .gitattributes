# Auto-detect text files and normalize line endings
* text=auto

# C source files
*.c text eol=lf
*.h text eol=lf

# Python
*.py text eol=lf

# Web files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Config / data
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf
*.conf text eol=lf

# Windows batch
*.bat text eol=crlf
*.ps1 text eol=crlf

# Makefile - must use tabs
Makefile text eol=lf

# Binaries
*.exe binary
*.o   binary
