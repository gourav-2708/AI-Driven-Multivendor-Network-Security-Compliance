# Copy to .env (git-ignored) to store audit history in MongoDB locally.
# Leave MONGODB_URI unset to keep history in JSON files under frontends/web/history.
# On Vercel, set these under Project Settings > Environment Variables instead.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Database to use when the URI does not name one (default: net_audit)
# MONGODB_DB=net_audit
