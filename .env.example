# Settings for the web dashboard. Copy to .env (git-ignored) for a local run.
# On Vercel, set them under Project Settings > Environment Variables; in Docker,
# under `environment:` in docker-compose.yml. Every setting is optional.

# ---- Storage -----------------------------------------------------------------
# Unset: everything is kept in a SQLite file (net-audit.db) in the data directory.
# Set: everything is kept in MongoDB. Required on Vercel, where files are temporary.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# Database to use when the URI does not name one (default: net_audit)
# MONGODB_DB=net_audit
# Where the SQLite file, the session key and scratch files live
# (default: frontends/web locally, /data in Docker, /tmp/net-audit on Vercel)
# NET_AUDIT_DATA_DIR=/var/lib/net-audit

# ---- Accounts ----------------------------------------------------------------
# Signs session cookies. Unset: a key is generated and kept in the data directory.
# Set it on Vercel, where the data directory does not persist.
# NET_AUDIT_SECRET_KEY=change-me-to-a-long-random-string
# open (default): anyone can create an account, which starts a new organization.
# closed: only the first account can be created; everyone else is invited.
# NET_AUDIT_SIGNUP=closed
# 1 when the dashboard is served over HTTPS (default: 1 on Vercel, 0 elsewhere)
# NET_AUDIT_COOKIE_SECURE=1
# Public address of the dashboard, used in links sent by email
# NET_AUDIT_BASE_URL=https://net-audit.example.com
# NET_AUDIT_SESSION_HOURS=12
# Shown on the privacy policy page (/privacy)
# NET_AUDIT_OPERATOR=Example Networks Ltd
# NET_AUDIT_PRIVACY_CONTACT=privacy@example.com
# Minutes the control register stays editable after an admin re-enters their password
# NET_AUDIT_ADMIN_UNLOCK_MINUTES=15

# ---- Email (invitations, password resets, alerts, scheduled reports) -----------
# Without SMTP_HOST, one-time links are shown to the administrator and written to
# the server log instead of being emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=net-audit@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=net-audit@example.com
# SMTP_STARTTLS=1

# ---- Sources and schedules -------------------------------------------------------
# The scheduler thread runs due sources and reports (default: on, off on Vercel).
# NET_AUDIT_SCHEDULER=1
# Without the thread, call GET /api/cron on a timer with "Authorization: Bearer <secret>".
# Vercel Cron sends this header by itself when CRON_SECRET is set.
# CRON_SECRET=change-me-to-a-long-random-string
# "Folder on this server" sources may only read below this folder. Unset: switched off.
# NET_AUDIT_INTAKE_ROOT=/srv/network-backups
# 1: refuse outbound calls (Oxidized, Slack, Jira, ServiceNow) to private or loopback
# addresses. Turn on when people you do not know can sign up.
# NET_AUDIT_BLOCK_PRIVATE_URLS=1

# ---- Limits (self-hosted; Vercel is fixed at 4 MB and 25 s) ----------------------
# NET_AUDIT_MAX_UPLOAD_MB=100
# NET_AUDIT_TIMEOUT_S=300

# ---- Other -----------------------------------------------------------------------
# 1: do not ask browsers to load web fonts from the internet (air-gapped networks)
# NET_AUDIT_OFFLINE=1
# Auditor binary, when it is not at build/release/net-audit
# NET_AUDIT_BIN=/usr/local/bin/net-audit
