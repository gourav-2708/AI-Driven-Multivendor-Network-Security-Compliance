# ============================================================
#  net-audit  -  .gitignore
# ============================================================

# --- Build output (binaries, objects, test runner, docs) ---
build/
*.o
*.d
*.exe
net-audit-test-report.tmp

# --- Vercel: generated static output and local CLI state ---
public/
.vercel/

# --- Python ---
__pycache__/
*.py[cod]
.env
.venv/
venv/
env/
*.egg-info/
dist/

# --- Web front-end runtime data (uploads & audit history) ---
frontends/web/uploads/*
frontends/web/history/*
!frontends/web/uploads/.gitkeep
!frontends/web/history/.gitkeep

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# --- Editor / IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
