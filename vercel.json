{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "bash scripts/vercel-build.sh",
  "functions": {
    "index.py": {
      "maxDuration": 30,
      "includeFiles": "{build/release/net-audit,frontends/web/app.py,frontends/web/templates/**}",
      "excludeFiles": "{src/**,include/**,tests/**,docs/**,examples/**,public/**,scripts/**,build/release/obj/**,build/debug/**,frontends/desktop/**,frontends/viewer/**,frontends/web/static/**,frontends/web/history/**,frontends/web/uploads/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
